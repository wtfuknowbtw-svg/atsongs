# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/music-app

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Backblaze B2 Configuration (S3-compatible, required)
B2_KEY_ID=
B2_APP_KEY=
B2_ENDPOINT=
B2_BUCKET=

# Cloudinary Configuration (legacy, optional — leave unset for B2 storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Upload Configuration
MAX_UPLOAD_SIZE=52428800
ALLOWED_FORMATS=mp3,flac,wav,aac,m4a,ogg

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Admin Configuration (optional - for first admin setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
